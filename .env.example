# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketing?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-value"
NEXTAUTH_SECRET="replace-with-a-long-random-value"

# Public base URL of the deployed app (used in QR verification links and emails)
APP_URL="https://your-domain.example"
NODE_ENV="production"

# Transactional email (SMTP). Leave SMTP_HOST empty to log emails to the
# console instead of sending them (useful for local development).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Afterdark.jo <no-reply@afterdark.jo>"

# Default CliQ business alias shown to customers at checkout. This can also be
# edited live from Admin > Settings > Payment without a redeploy.
CLIQ_ALIAS="AFTERDARKJO"
BUSINESS_NAME="Afterdark.jo"
